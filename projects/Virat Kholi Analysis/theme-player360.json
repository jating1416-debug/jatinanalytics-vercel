{
  "name": "Player 360 · Light",
  "dataColors": [
    "#2563eb",
    "#0f9f8f",
    "#7c3aed",
    "#f59e0b",
    "#4d8dff",
    "#21c9b4",
    "#a78bfa",
    "#ec4899",
    "#98a2b3",
    "#cbd5e1"
  ],
  "background": "#f8fafc",
  "foreground": "#101828",
  "tableAccent": "#2563eb",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#ffffff" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#e4e7ec" } },
            "radius": 8
          }
        ],
        "title": [
          {
            "color": { "solid": { "color": "#667085" } },
            "fontFace": "Segoe UI",
            "fontSize": 10,
            "fontWeight": "bold"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#98a2b3" } },
            "gridlineColor": { "solid": { "color": "#e4e7ec" } },
            "showGridlines": true
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#98a2b3" } },
            "gridlineColor": { "solid": { "color": "#e4e7ec" } },
            "showGridlines": true
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#101828" } },
            "fontSize": 26, "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#98a2b3" } },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#344054" } },
            "fontSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#98a2b3" } },
            "fontSize": 9,
            "backColor": { "solid": { "color": "#f8fafc" } }
          }
        ]
      }
    }
  }
}